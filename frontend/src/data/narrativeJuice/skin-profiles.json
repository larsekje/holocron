{
  "_meta": {
    "version": "1.0",
    "description": "Skin tone profiles for the Narrative Juice GM tool. Each skin defines its baseline tone profile (mean + spread on four axes), heat adjustments (deltas applied at heat 2 and 3), and bias adjustments (deltas applied when a bias tag is active). The app loads this file at startup, and when the user picks a skin + heat + active biases, it computes the effective tone target and uses that to drive (a) the visual dials and (b) the matching algorithm.",
    "tone_axes": ["pulpy", "seedy", "intrigue", "refined"],
    "tone_range": [-1, 2],
    "heat_levels": [1, 2, 3],
    "bias_tags": ["imperial", "rebel", "underworld", "corporate", "mystical", "frontier", "noble"]
  },

